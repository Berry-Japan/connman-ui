#include <gtk/gtk.h>
#include <errno.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

// ============================================================================
// Section 1: Connman Interface Stub/Mock Implementation
// This section provides a mock implementation of the connman library functions
// to allow the UI to compile and run without a real connman connection.
// ============================================================================

// --- Enums and Structs ---
typedef enum {
	CONNMAN_STATE_UNKNOWN,
	CONNMAN_STATE_IDLE,
	CONNMAN_STATE_READY,
	CONNMAN_STATE_ONLINE
} connman_state;

typedef struct {
	char *method;
	char *address;
	char *netmask;
	char *gateway;
} connman_ipv4;

typedef struct {
	char *method;
	char *address;
	guint prefix;
	char *gateway;
	char *privacy;
} connman_ipv6;

typedef struct {
	char *method;
	char *url;
	char *servers;
	char *excludes;
} connman_proxy;

// --- Callback Pointers ---
static void (*manager_changed_cb)(const char*, const char*, void*) = NULL;
static void (*service_removed_cb)(const char*) = NULL;
static void (*technology_added_cb)(const char*) = NULL;
static void (*technology_removed_cb)(const char*) = NULL;
static void (*g_agent_error_cb)(const char*, const char*) = NULL;
static void (*g_agent_cancel_cb)(void) = NULL;
static void (*g_agent_input_cb)(const char*, gboolean, gboolean, gboolean, const char*, gboolean, const char*, gboolean) = NULL;

// --- Mock Data and Functions ---
static connman_state mock_manager_state = CONNMAN_STATE_ONLINE;
static gboolean mock_offline_mode = FALSE;

const char *mock_services[][5] = {
    {"/net/connman/service/ethernet_local", "Wired", "ethernet", "online", "100"},
    {"/net/connman/service/wifi_home", "MyHomeWiFi", "wifi", "ready", "85"},
    {"/net/connman/service/wifi_public", "Free Public WiFi", "wifi", "idle", "60"},
    {"/net/connman/service/cellular_provider", "MyCellular", "cellular", "idle", "95"},
};

const char *mock_technologies[][3] = {
    {"/net/connman/technology/ethernet", "Wired", "ethernet"},
    {"/net/connman/technology/wifi", "WiFi", "wifi"},
    {"/net/connman/technology/cellular", "Cellular", "cellular"},
};

connman_state connman_manager_get_state(void) { return mock_manager_state; }
gboolean connman_manager_get_offlinemode(void) { return mock_offline_mode; }
void connman_manager_set_offlinemode(gboolean mode) {
    mock_offline_mode = mode;
    mock_manager_state = mode ? CONNMAN_STATE_IDLE : CONNMAN_STATE_ONLINE;
    if (manager_changed_cb) manager_changed_cb(NULL, "State", NULL);
}
void connman_manager_init(void (*cb)(const char*, const char*, void*), void* data) { manager_changed_cb = cb; }
void connman_manager_finalize(void) {}

GSList* connman_service_get_services(void) {
    GSList *services = NULL;
    for (size_t i = 0; i < G_N_ELEMENTS(mock_services); i++) {
        services = g_slist_append(services, g_strdup(mock_services[i][0]));
    }
    return services;
}
void connman_service_free_services_list(void) {}
const char* connman_service_get_name(const char *path) {
    for (size_t i = 0; i < G_N_ELEMENTS(mock_services); i++) {
        if (g_strcmp0(path, mock_services[i][0]) == 0) return mock_services[i][1];
    }
    return "Unknown Service";
}
const char* connman_service_get_type(const char *path) {
    for (size_t i = 0; i < G_N_ELEMENTS(mock_services); i++) {
        if (g_strcmp0(path, mock_services[i][0]) == 0) return mock_services[i][2];
    }
    return "unknown";
}
connman_state connman_service_get_state(const char *path) {
    for (size_t i = 0; i < G_N_ELEMENTS(mock_services); i++) {
        if (g_strcmp0(path, mock_services[i][0]) == 0) {
            if (g_strcmp0(mock_services[i][3], "online") == 0) return CONNMAN_STATE_ONLINE;
            if (g_strcmp0(mock_services[i][3], "ready") == 0) return CONNMAN_STATE_READY;
        }
    }
    return CONNMAN_STATE_IDLE;
}
gboolean connman_service_is_connected(const char *path) {
    return connman_service_get_state(path) == CONNMAN_STATE_ONLINE;
}
uint8_t connman_service_get_strength(const char *path) {
     for (size_t i = 0; i < G_N_ELEMENTS(mock_services); i++) {
        if (g_strcmp0(path, mock_services[i][0]) == 0) return (uint8_t)atoi(mock_services[i][4]);
    }
    return 0;
}
int connman_service_connect(const char* path) {
    g_print("Attempting to connect to: %s\n", path);
    if(g_str_has_prefix(path, "/net/connman/service/wifi")) {
        if(g_agent_input_cb) g_agent_input_cb(path, FALSE, FALSE, TRUE, "12345678", FALSE, NULL, FALSE);
    }
    return 0;
}
void connman_service_disconnect(const char* path) { g_print("Disconnecting from: %s\n", path); }
void connman_service_init(void) {}
void connman_service_finalize(void) {}
void connman_service_set_removed_callback(void (*cb)(const char*)) { service_removed_cb = cb; }
void connman_service_refresh_services_list(void (*cb_get)(void*), void (*cb_scan)(void*), void* data) {
    if (cb_get) cb_get(data);
    if (cb_scan) cb_scan(data);
}
const char* connman_service_get_security(const char *path) { return "wpa2-psk"; }
// Other dummy service functions...
GList* connman_technology_get_technologies(void) {
    GList *techs = NULL;
    for (size_t i = 0; i < G_N_ELEMENTS(mock_technologies); i++) {
        techs = g_list_append(techs, g_strdup(mock_technologies[i][0]));
    }
    return techs;
}
const char* connman_technology_get_name(const char *path) {
    for (size_t i = 0; i < G_N_ELEMENTS(mock_technologies); i++) {
        if (g_strcmp0(path, mock_technologies[i][0]) == 0) return mock_technologies[i][1];
    }
    return "Unknown Tech";
}
gboolean connman_technology_is_enabled(const char *path) { return TRUE; }
int connman_technology_enable(const char *path, gboolean enable) {
    g_print("Setting technology %s: %s\n", path, enable ? "ON" : "OFF");
    return 0;
}
void connman_technology_init(void) {}
void connman_technology_finalize(void) {}
// Other dummy technology functions...
void connman_agent_init(void) {}
void connman_agent_finalize(void) {}
void connman_agent_set_error_cb(void (*cb)(const char*, const char*)) { g_agent_error_cb = cb; }
void connman_agent_set_cancel_cb(void (*cb)(void)) { g_agent_cancel_cb = cb; }
void connman_agent_set_input_cb(void (*cb)(const char*, gboolean, gboolean, gboolean, const char*, gboolean, const char*, gboolean)) { g_agent_input_cb = cb; }
void connman_agent_set_browser_cb(void (*cb)(const char*, const char*)) {}
void connman_agent_reply_passphrase(const char *name, const char *passphrase, gboolean wps, const char *wpspin) {
    g_print("Agent replied with passphrase.\n");
}
void connman_agent_reply_canceled(void) { g_print("Agent request canceled.\n"); }
// Other dummy agent functions...
int connman_interface_init(void (*up_cb)(void*), void (*down_cb)(void*), void* data) {
    if (up_cb) up_cb(data);
    return 0;
}
void connman_interface_finalize(void) {}


