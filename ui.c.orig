// --- Global UI Widgets & Data ---
static GtkWidget *main_window = NULL;
static GtkWidget *main_window_icon = NULL;
static GtkWidget *left_menu_button = NULL;
static GtkWidget *right_menu_button = NULL;

static GtkWidget *left_popover = NULL;
static GtkWidget *left_popover_box = NULL;
static GtkWidget *left_popover_spinner = NULL;
static GHashTable *service_items_hash = NULL;

static GtkWidget *right_popover = NULL;
static GtkWidget *right_popover_box = NULL;
static GHashTable *tech_items_hash = NULL;

