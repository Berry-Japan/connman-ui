	char *path;
	char *name;
};
static struct cui_selected_service selected_service;

// --- Theme/Icon Utilities ---
static GtkIconTheme *icon_theme = NULL;

static void cui_load_theme(void) {
	icon_theme = gtk_icon_theme_get_for_display(gdk_display_get_default());
}

static GdkPaintable* get_icon_paintable(const char *icon_name, int size) {
    if (!icon_theme) return NULL;
    GIcon *icon = g_themed_icon_new(icon_name);
    // CORRECTED: Explicitly cast the return value to GdkPaintable.
    // This is necessary for GTK >= 4.10 where the return type changed to GtkIconPaintable.
    GdkPaintable *paintable = GDK_PAINTABLE(gtk_icon_theme_lookup_by_gicon(icon_theme, icon, size, 1, GTK_TEXT_DIR_LTR, 0));
    g_object_unref(icon);
    return paintable;
}

static void cui_theme_get_state_icon_and_info(connman_state state, GdkPaintable **paintable, const char **info) {
	const char *icon_name = "network-offline-symbolic";
	const char *info_text = "Disconnected";

	switch (state) {
		case CONNMAN_STATE_IDLE: // Added idle state handling
			icon_name = "network-idle-symbolic";
			info_text = "Idle";
			break;
		case CONNMAN_STATE_READY:
		case CONNMAN_STATE_ONLINE:
			icon_name = "network-transmit-receive-symbolic";
			info_text = "Online";
			break;
		default:
			break;
	}

	if (paintable) *paintable = get_icon_paintable(icon_name, 24);
	if (info) *info = info_text;
}

static void cui_theme_get_signal_icon_and_info(uint8_t strength, GdkPaintable **paintable, const char **info) {
	const char *icon_name;
	const char *info_text;

	if (strength >= 80) {
		icon_name = "network-wireless-signal-excellent-symbolic";
		info_text = "Very good signal";
	} else if (strength >= 60) {
		icon_name = "network-wireless-signal-good-symbolic";
		info_text = "Good signal";
	} else if (strength >= 40) {
		icon_name = "network-wireless-signal-ok-symbolic";
		info_text = "Low signal";
	} else {
		icon_name = "network-wireless-signal-weak-symbolic";
		info_text = "Very low signal";
	}

	if (paintable) *paintable = get_icon_paintable(icon_name, 22);
	if (info) *info = info_text;
}

static void cui_theme_get_type_icon_and_info(const char *type, GdkPaintable **paintable, const char **info) {
	const char *icon_name = NULL;
	const char *info_text = NULL;

	if (g_strcmp0(type, "ethernet") == 0) {
		icon_name = "network-wired-symbolic";
		info_text = "Ethernet";
	} else if (g_strcmp0(type, "cellular") == 0) {
		icon_name = "network-cellular-signal-good-symbolic";
		info_text = "Cellular";
	}

    if (paintable && icon_name) *paintable = get_icon_paintable(icon_name, 22);
	if (info) *info = info_text;
}

// --- Service Row Widget ---
static void on_service_row_clicked(GtkGestureClick *gesture, int n_press, double x, double y, GtkWidget *widget) {
    char *path = g_object_get_data(G_OBJECT(widget), "service-path");

    guint button = gtk_gesture_single_get_current_button(GTK_GESTURE_SINGLE(gesture));

    if (button == GDK_BUTTON_PRIMARY) {
        if (connman_service_is_connected(path)) {
            connman_service_disconnect(path);
        } else {
            cui_agent_set_selected_service(path, connman_service_get_name(path));
            connman_service_connect(path);
        }
    } else if (button == GDK_BUTTON_SECONDARY) {
        cui_settings_popup(path, gtk_widget_get_ancestor(widget, GTK_TYPE_WINDOW));
    }
    gtk_popover_popdown(GTK_POPOVER(left_popover));
}

static GtkWidget* create_service_row_widget(const char* path) {
    const char *name_str = connman_service_get_name(path);
    if (!name_str) name_str = "- Hidden -";

    GtkWidget *box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 10);
    g_object_set_data_full(G_OBJECT(box), "service-path", g_strdup(path), g_free);

    char *markup;
    if (g_strcmp0(connman_service_get_type(path), "wifi") == 0) {
        markup = g_markup_printf_escaped("%s <i>(%s)</i>", name_str, connman_service_get_security(path));
    } else {
        markup = g_markup_printf_escaped("%s", name_str);
    }
    GtkWidget *name_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(name_label), markup);
    gtk_widget_set_hexpand(name_label, TRUE);
    gtk_widget_set_halign(name_label, GTK_ALIGN_START);
    g_free(markup);
    gtk_box_append(GTK_BOX(box), name_label);

    connman_state state = connman_service_get_state(path);
    if (connman_service_is_connected(path)) {
        GdkPaintable *state_paintable = NULL;
        cui_theme_get_state_icon_and_info(state, &state_paintable, NULL);
        if (state_paintable) {
            gtk_box_append(GTK_BOX(box), gtk_image_new_from_paintable(state_paintable));
            g_object_unref(state_paintable);
        }
    }

    const char *type = connman_service_get_type(path);
    GdkPaintable *signal_paintable = NULL;
    const char *signal_info = NULL;
    if (g_strcmp0(type, "wifi") == 0) {
        cui_theme_get_signal_icon_and_info(connman_service_get_strength(path), &signal_paintable, &signal_info);
    } else {
        cui_theme_get_type_icon_and_info(type, &signal_paintable, &signal_info);
    }
    if (signal_paintable) {
        GtkWidget *signal_icon = gtk_image_new_from_paintable(signal_paintable);
        gtk_widget_set_tooltip_text(signal_icon, signal_info);
        gtk_box_append(GTK_BOX(box), signal_icon);
        g_object_unref(signal_paintable);
    }

    GtkGesture *click = gtk_gesture_click_new();
    gtk_gesture_single_set_button(GTK_GESTURE_SINGLE(click), 0);
    g_signal_connect(click, "released", G_CALLBACK(on_service_row_clicked), box);
    gtk_widget_add_controller(box, GTK_EVENT_CONTROLLER(click));

    return box;
}

// --- Left Popover (Services List) ---
static void clear_service_list(void) {
    GtkWidget *child;
    while ((child = gtk_widget_get_first_child(left_popover_box))) {
        gtk_box_remove(GTK_BOX(left_popover_box), child);
    }
}

static void get_services_cb(void *user_data) {
    clear_service_list();
    GSList *services = connman_service_get_services();
    for (GSList *list = services; list; list = list->next) {
        gtk_box_append(GTK_BOX(left_popover_box), create_service_row_widget(list->data));
    }
    g_slist_free_full(services, g_free);
    gtk_spinner_stop(GTK_SPINNER(left_popover_spinner));
    gtk_widget_set_visible(left_popover_spinner, FALSE);
}

static void on_left_menu_button_clicked(GtkButton *button, gpointer user_data) {
    clear_service_list();
    gtk_box_append(GTK_BOX(left_popover_box), left_popover_spinner);
    gtk_widget_set_visible(left_popover_spinner, TRUE);
    gtk_spinner_start(GTK_SPINNER(left_popover_spinner));
    connman_service_refresh_services_list(get_services_cb, NULL, NULL);
    gtk_popover_popup(GTK_POPOVER(left_popover));
}

static void create_left_popover(void) {
    left_popover = gtk_popover_new();
    gtk_widget_set_parent(left_popover, left_menu_button);
    left_popover_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 5);
    gtk_widget_set_size_request(left_popover_box, 250, -1);
    gtk_popover_set_child(GTK_POPOVER(left_popover), left_popover_box);
    left_popover_spinner = gtk_spinner_new();
}

// --- Technology Row Widget & Right Popover ---
static void on_technology_toggled(GtkSwitch *sw, gboolean state, gpointer user_data) {
    gtk_widget_set_sensitive(GTK_WIDGET(sw), FALSE);
    connman_technology_enable(g_object_get_data(G_OBJECT(sw), "tech-path"), state);
    gtk_widget_set_sensitive(GTK_WIDGET(sw), TRUE);
}

static void on_offline_mode_activated(GtkButton *button, gpointer user_data) {
    connman_manager_set_offlinemode(GPOINTER_TO_INT(user_data));
    gtk_popover_popdown(GTK_POPOVER(right_popover));
}

static void on_quit_activated(GtkButton *button, gpointer user_data) {
    g_application_quit(G_APPLICATION(gtk_window_get_application(GTK_WINDOW(main_window))));
}

static void on_right_menu_button_clicked(GtkButton *button, gpointer user_data) {
    for (GtkWidget *child = gtk_widget_get_first_child(right_popover_box); child; ) {
        GtkWidget *next_child = gtk_widget_get_next_sibling(child);
        if (g_object_get_data(G_OBJECT(child), "is-tech")) {
            gtk_box_remove(GTK_BOX(right_popover_box), child);
        }
        child = next_child;
    }

    gboolean is_offline = connman_manager_get_offlinemode();
    gtk_widget_set_visible(offline_mode_on_item, !is_offline);
    gtk_widget_set_visible(offline_mode_off_item, is_offline);

    GList *tech_list = connman_technology_get_technologies();
    for (GList *list = tech_list; list != NULL; list = list->next) {
        GtkWidget *box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 10);
        gtk_widget_set_halign(box, GTK_ALIGN_FILL);
        g_object_set_data(G_OBJECT(box), "is-tech", GINT_TO_POINTER(1));

        GtkWidget* label = gtk_label_new(connman_technology_get_name(list->data));
        gtk_widget_set_hexpand(label, TRUE);
        gtk_widget_set_halign(label, GTK_ALIGN_START);
        gtk_box_append(GTK_BOX(box), label);

        GtkWidget *sw = gtk_switch_new();
        g_object_set_data_full(G_OBJECT(sw), "tech-path", g_strdup(list->data), g_free);
        gtk_switch_set_active(GTK_SWITCH(sw), connman_technology_is_enabled(list->data));
        g_signal_connect(sw, "state-set", G_CALLBACK(on_technology_toggled), NULL);
        gtk_box_append(GTK_BOX(box), sw);
        gtk_box_insert_child_after(GTK_BOX(right_popover_box), box, offline_mode_off_item);
    }
    g_list_free_full(tech_list, g_free);

    gtk_popover_popup(GTK_POPOVER(right_popover));
}

static void create_right_popover(void) {
    right_popover = gtk_popover_new();
    gtk_widget_set_parent(right_popover, right_menu_button);
    right_popover_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 5);
    gtk_widget_set_size_request(right_popover_box, 200, -1);
    gtk_popover_set_child(GTK_POPOVER(right_popover), right_popover_box);

    offline_mode_on_item = gtk_button_new_with_label("Turn Offline Mode ON");
    g_signal_connect(offline_mode_on_item, "clicked", G_CALLBACK(on_offline_mode_activated), GINT_TO_POINTER(1));
    gtk_box_append(GTK_BOX(right_popover_box), offline_mode_on_item);
    offline_mode_off_item = gtk_button_new_with_label("Turn Offline Mode OFF");
    g_signal_connect(offline_mode_off_item, "clicked", G_CALLBACK(on_offline_mode_activated), GINT_TO_POINTER(0));
    gtk_box_append(GTK_BOX(right_popover_box), offline_mode_off_item);

    gtk_box_append(GTK_BOX(right_popover_box), gtk_separator_new(GTK_ORIENTATION_HORIZONTAL));
    GtkWidget *quit_item = gtk_button_new_with_label("Quit");
    g_signal_connect(quit_item, "clicked", G_CALLBACK(on_quit_activated), NULL);
    gtk_box_append(GTK_BOX(right_popover_box), quit_item);
}

// --- Agent Dialogs (Modern Implementation) ---
static GtkWidget *input_dialog = NULL;
static GtkEntry *secret_entry = NULL;

void cui_agent_set_selected_service(const char *path, const char *name) {
	g_free(selected_service.path);
	selected_service.path = g_strdup(path);
	g_free(selected_service.name);
	selected_service.name = g_strdup(name ? name : "Hidden");
}

static void on_agent_ok_clicked(GtkButton *button, gpointer user_data) {
    connman_agent_reply_passphrase(NULL, gtk_editable_get_text(GTK_EDITABLE(secret_entry)), FALSE, NULL);
    gtk_window_destroy(GTK_WINDOW(input_dialog));
    input_dialog = NULL;
}

static void on_agent_cancel_clicked(GtkButton* button, gpointer user_data) {
    connman_agent_reply_canceled();
    gtk_window_destroy(GTK_WINDOW(input_dialog));
    input_dialog = NULL;
}

static void agent_popup_input_dbox(const char *path, const char *previous_passphrase) {
    if (input_dialog) {
        gtk_window_present(GTK_WINDOW(input_dialog));
        return;
    }

    input_dialog = gtk_window_new();
    gtk_window_set_transient_for(GTK_WINDOW(input_dialog), GTK_WINDOW(main_window));
    gtk_window_set_modal(GTK_WINDOW(input_dialog), TRUE);
    gtk_window_set_destroy_with_parent(GTK_WINDOW(input_dialog), TRUE);
    gtk_window_set_title(GTK_WINDOW(input_dialog), "Passphrase Required");
    gtk_window_set_resizable(GTK_WINDOW(input_dialog), FALSE);

    GtkWidget *main_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 10);
    gtk_widget_set_margin_start(main_box, 12);
    gtk_widget_set_margin_end(main_box, 12);
    gtk_widget_set_margin_top(main_box, 12);
    gtk_widget_set_margin_bottom(main_box, 12);
    gtk_window_set_child(GTK_WINDOW(input_dialog), main_box);

    char *title_markup = g_markup_printf_escaped("<b>Connect to %s</b>", selected_service.name);
    gtk_box_append(GTK_BOX(main_box), gtk_label_new(title_markup));
    g_free(title_markup);

    GtkWidget *grid = gtk_grid_new();
    gtk_grid_set_column_spacing(GTK_GRID(grid), 10);
    gtk_box_append(GTK_BOX(main_box), grid);
    gtk_grid_attach(GTK_GRID(grid), gtk_label_new("Password:"), 0, 0, 1, 1);
    secret_entry = GTK_ENTRY(gtk_entry_new());
    gtk_entry_set_visibility(GTK_ENTRY(secret_entry), FALSE);
    gtk_widget_set_hexpand(GTK_WIDGET(secret_entry), TRUE);
    gtk_grid_attach(GTK_GRID(grid), GTK_WIDGET(secret_entry), 1, 0, 1, 1);

    if (previous_passphrase) {
         gtk_box_append(GTK_BOX(main_box), gtk_label_new("Previous passphrase was incorrect."));
    }

    GtkWidget *action_box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 6);
    gtk_widget_set_halign(action_box, GTK_ALIGN_END);
    gtk_box_append(GTK_BOX(main_box), action_box);

    GtkWidget *cancel_button = gtk_button_new_with_label("Cancel");
    g_signal_connect(cancel_button, "clicked", G_CALLBACK(on_agent_cancel_clicked), NULL);
    gtk_box_append(GTK_BOX(action_box), cancel_button);

    GtkWidget *ok_button = gtk_button_new_with_label("OK");
    // CORRECTED: Use gtk_window_set_default_widget to set the default button.
    gtk_window_set_default_widget(GTK_WINDOW(input_dialog), ok_button);
    g_signal_connect(ok_button, "clicked", G_CALLBACK(on_agent_ok_clicked), NULL);
    gtk_box_append(GTK_BOX(action_box), ok_button);

    gtk_widget_set_visible(input_dialog, TRUE);
}

static void agent_input_cb_impl(const char *path, gboolean hidden, gboolean identity,
                           gboolean passphrase, const char *previous_passphrase,
                           gboolean wpspin, const char *previous_wpspin, gboolean login) {
    if (g_strcmp0(path, selected_service.path) == 0 && passphrase) {
        agent_popup_input_dbox(path, previous_passphrase);
    } else {
        connman_agent_reply_canceled();
    }
}

static void agent_cancel_cb_impl(void) {
    if (input_dialog) {
        gtk_window_destroy(GTK_WINDOW(input_dialog));
        input_dialog = NULL;
    }
}

static void cui_agent_init_callbacks(void) {
	connman_agent_set_input_cb(agent_input_cb_impl);
    connman_agent_set_cancel_cb(agent_cancel_cb_impl);
}

// --- Settings Dialog (Modern Implementation) ---
static void cui_settings_popup(const char *selected_path, GtkWidget *parent) {
    GtkWidget *dialog = gtk_window_new();
    gtk_window_set_transient_for(GTK_WINDOW(dialog), GTK_WINDOW(parent));
    gtk_window_set_modal(GTK_WINDOW(dialog), TRUE);
    gtk_window_set_title(GTK_WINDOW(dialog), "Service Settings");

    GtkWidget *box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 10);
    gtk_widget_set_margin_start(box, 12);
    gtk_widget_set_margin_end(box, 12);
    gtk_widget_set_margin_top(box, 12);
    gtk_widget_set_margin_bottom(box, 12);
    gtk_window_set_child(GTK_WINDOW(dialog), box);

    char *title_markup = g_markup_printf_escaped("<b>Settings for %s</b>", connman_service_get_name(selected_path));
    gtk_box_append(GTK_BOX(box), gtk_label_new(title_markup));
    g_free(title_markup);

    gtk_box_append(GTK_BOX(box), gtk_label_new("A full settings dialog would be here."));

    GtkWidget *close_button = gtk_button_new_with_label("Close");
    gtk_widget_set_halign(close_button, GTK_ALIGN_END);
    g_signal_connect_swapped(close_button, "clicked", G_CALLBACK(gtk_window_destroy), dialog);
    gtk_box_append(GTK_BOX(box), close_button);

    gtk_widget_set_visible(dialog, TRUE);
}

// --- Main Window and App Lifecycle ---
void update_main_window_icon(void) {
    connman_state state = connman_manager_get_state();
    GdkPaintable *paintable = NULL;
    const char *info = NULL;
    cui_theme_get_state_icon_and_info(state, &paintable, &info);
    if (paintable) {
        gtk_image_set_from_paintable(GTK_IMAGE(main_window_icon), paintable);
        g_object_unref(paintable);
    }
    gtk_widget_set_tooltip_text(main_window_icon, info);
}

static void connman_up(void *user_data) {
	cui_agent_init_callbacks();
	update_main_window_icon();
}

static void create_main_window(GtkApplication *app) {
	main_window = gtk_application_window_new(app);
	gtk_window_set_title(GTK_WINDOW(main_window), "Connman UI");
    gtk_window_set_default_size(GTK_WINDOW(main_window), 200, 50);
    gtk_window_set_resizable(GTK_WINDOW(main_window), FALSE);

	GtkWidget *box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 5);
    gtk_widget_set_margin_start(box, 10);
    gtk_widget_set_margin_end(box, 10);
    gtk_widget_set_margin_top(box, 10);
    gtk_widget_set_margin_bottom(box, 10);
	gtk_window_set_child(GTK_WINDOW(main_window), box);

	main_window_icon = gtk_image_new();
	gtk_box_append(GTK_BOX(box), main_window_icon);

    left_menu_button = gtk_button_new_with_label("Networks");
    g_signal_connect(left_menu_button, "clicked", G_CALLBACK(on_left_menu_button_clicked), NULL);
    gtk_box_append(GTK_BOX(box), left_menu_button);
    create_left_popover();

    right_menu_button = gtk_button_new_with_label("Settings");
    g_signal_connect(right_menu_button, "clicked", G_CALLBACK(on_right_menu_button_clicked), NULL);
    gtk_box_append(GTK_BOX(box), right_menu_button);
    create_right_popover();

    update_main_window_icon();
    gtk_window_present(GTK_WINDOW(main_window));
}

static void activate_app(GtkApplication *app, gpointer user_data) {
	cui_load_theme();
	create_main_window(app);
	connman_interface_init(connman_up, NULL, NULL);
}

int main(int argc, char *argv[]) {
	GtkApplication *app = gtk_application_new("org.connman.gtk4ui", G_APPLICATION_DEFAULT_FLAGS);
	g_signal_connect(app, "activate", G_CALLBACK(activate_app), NULL);

	int status = g_application_run(G_APPLICATION(app), argc, argv);

    g_free(selected_service.path);
    g_free(selected_service.name);
    g_object_unref(app);

	return status;
}
